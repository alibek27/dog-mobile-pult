[Unit]
Description=MediaMTX для лёгких копий камер (телефон) @NAME@
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=unitree
WorkingDirectory=/home/unitree
ExecStartPre=+/usr/local/bin/@NAME@-fwlock.sh 1936 "tcp"
ExecStartPre=+/usr/local/bin/@NAME@-fwlock.sh 8890 "tcp"
ExecStartPre=+/usr/local/bin/@NAME@-fwlock.sh 8190 "udp"
ExecStart=/home/unitree/mediamtx /home/unitree/mediamtx-tiny.yml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
