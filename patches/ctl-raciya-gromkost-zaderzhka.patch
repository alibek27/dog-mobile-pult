+# ── ГРОМКОСТЬ СИРЕНЫ И РАЦИИ ────────────────────────────────────────────
+# Колонка аппаратно уже на максимуме (PCM 100%, 0 дБ), и обе играют прямо в
+# ALSA, мимо pulse — значит громкость можно крутить только программно, умножая
+# сам звук. 1.0 = как было до 19.09. Выше 1.0 — громче, но упирается в шкалу:
+# пики режутся, звук грубеет. Для сирены это приемлемо (её задача — быть
+# слышной), для рации оператор решает сам, ползунком.
+#
+# Хранится в файле, а не в памяти: служба перезапускается, а оператор, раз
+# выставив «сирену потише», не должен вспоминать об этом после каждого старта.
+VOL_FILE = os.environ.get("CTL_VOL_FILE", os.path.join(APP, "config", "volume.json"))
+VOL_MAX = float(os.environ.get("CTL_VOL_MAX", "2.0"))
+_vol = {"siren": 1.0, "radio": 1.0}
+try:
+    with open(VOL_FILE) as _f:
+        for _k, _v in json.load(_f).items():
+            if _k in _vol:
+                _vol[_k] = max(0.0, min(float(_v), VOL_MAX))
+except Exception:
+    pass
+
+
+def vol_state():
+    return {"siren": int(round(_vol["siren"] * 100)), "radio": int(round(_vol["radio"] * 100)),
+            "max": int(round(VOL_MAX * 100))}
+
+
+def vol_set(siren=None, radio=None):
+    changed = []
+    for k, v in (("siren", siren), ("radio", radio)):
+        if v is None or v == "":
+            continue
+        v = max(0.0, min(float(v) / 100.0, VOL_MAX))
+        if abs(v - _vol[k]) > 1e-6:
+            _vol[k] = v
+            changed.append(k)
+    if changed:
+        try:
+            tmp = VOL_FILE + ".part"
+            with open(tmp, "w") as f:
+                json.dump(_vol, f)
+            os.replace(tmp, VOL_FILE)
+        except Exception as e:
+            log("громкость не сохранилась:", e)
+        jlog("vol", **vol_state())
+        log("громкость:", vol_state())
+        # Сирена уже воет — пусть новая громкость слышна сразу, а не со
+        # следующего круга (круг у длинной записи — 27 с).
+        if "siren" in changed:
+            with _siren_lock:
+                if _siren["on"] and _siren.get("proc") is not None:
+                    _siren["restart"] = True
+    st = vol_state()
+    st["ok"] = True
+    return st
+
+
+def _siren_scaled(path):
+    """Файл сирены с текущей громкостью. 100% — сам исходник; иначе копия в
+    /run (память, пропадает при перезагрузке), по одной на громкость."""
+    v = _vol["siren"]
+    if abs(v - 1.0) < 0.005:
+        return path
+    import audioop
+    import contextlib
+    import wave
+    d = os.path.dirname(PULT_FLAG) or "/tmp"
+    base = os.path.splitext(os.path.basename(path))[0]
+    out = os.path.join(d, "siren-%s-v%03d.wav" % (base, int(round(v * 100))))
+    if os.path.exists(out):
+        return out
+    with contextlib.closing(wave.open(path)) as w:
+        prm = w.getparams()
+        pcm = w.readframes(w.getnframes())
+    pcm = audioop.mul(pcm, prm.sampwidth, v)
+    # Старые копии этой же сирены с другой громкостью — прочь, чтобы /run не пух.
+    try:
+        for n in os.listdir(d):
+            if n.startswith("siren-%s-v" % base) and n.endswith(".wav"):
+                os.unlink(os.path.join(d, n))
+    except Exception:
+        pass
+    tmp = out + ".part"
+    with contextlib.closing(wave.open(tmp, "wb")) as w2:
+        w2.setparams(prm)
+        w2.writeframes(pcm)
+    os.replace(tmp, out)
+    return out
+
