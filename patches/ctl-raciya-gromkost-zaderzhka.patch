+# ── ESP32: фары и стробоскоп ─────────────────────────────────────────────
+# Плата ESP32 (CP2102) на серийном порту принимает текстовые команды (main.cpp):
+# setHeadlightLow_on/off, setHeadlightHigh_on/off, setStroboscopeState_on/off,
+# changeStroboscopeMode, alarm. Порт держим ОТКРЫТЫМ постоянно: повторное
+# открытие дёргает DTR и сбрасывает ESP32.
+ESP_DEV = os.environ.get("CTL_ESP_DEV", "/dev/ttyUSB0")
+ESP_MAP = {
+    "headlight_low_on":   "setHeadlightLow_on",
+    "headlight_low_off":  "setHeadlightLow_off",
+    "headlight_high_on":  "setHeadlightHigh_on",
+    "headlight_high_off": "setHeadlightHigh_off",
+    "strobe_on":          "setStroboscopeState_on",
+    "strobe_off":         "setStroboscopeState_off",
+    "strobe_mode":        "changeStroboscopeMode",
+    "alarm":              "alarm",
+}
+_esp_state = {"hl_low": False, "hl_high": False, "strobe": False}
+_esp_fd = None
+_esp_lock = threading.Lock()
+
+
+def _esp_open():
+    global _esp_fd
+    if _esp_fd is not None:
+        return _esp_fd
+    fd = os.open(ESP_DEV, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
+    a = termios.tcgetattr(fd)
+    a[0] = 0                                     # iflag
+    a[1] = 0                                     # oflag
+    a[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
+    a[3] = 0                                     # lflag
+    a[4] = termios.B115200                       # ispeed
+    a[5] = termios.B115200                       # ospeed
+    termios.tcsetattr(fd, termios.TCSANOW, a)
+    _esp_fd = fd
+    return fd
+
+
+def esp_send(key):
+    """Отправить команду ESP32 по ключу из ESP_MAP. Возвращает (ok, ошибка)."""
+    cmd = ESP_MAP.get(key)
+    if cmd is None:
+        return False, "неизвестная команда ESP"
+    global _esp_fd
+    with _esp_lock:
+        try:
+            fd = _esp_open()
+            os.write(fd, (cmd + "\n").encode("ascii"))
+        except Exception as e:
+            try:
+                if _esp_fd is not None:
+                    os.close(_esp_fd)
+            except Exception:
+                pass
+            _esp_fd = None
+            return False, "ESP не отвечает: %s" % str(e)[:120]
+    if   key == "headlight_low_on":   _esp_state["hl_low"]  = True
+    elif key == "headlight_low_off":  _esp_state["hl_low"]  = False
+    elif key == "headlight_high_on":  _esp_state["hl_high"] = True
+    elif key == "headlight_high_off": _esp_state["hl_high"] = False
+    elif key == "strobe_on":          _esp_state["strobe"]  = True
+    elif key == "strobe_off":         _esp_state["strobe"]  = False
+    return True, ""
+
