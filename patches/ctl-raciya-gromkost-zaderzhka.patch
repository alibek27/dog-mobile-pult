+# ── РАЦИЯ ПОТОКОМ ───────────────────────────────────────────────────────
+# /speak ждёт всю фразу целиком. Здесь звук идёт кусками ~0.25 с, пока оператор
+# ещё говорит, и сразу уходит в один долгоживущий aplay. Куски приходят
+# параллельно и могут обогнать друг друга — складываем по номеру, играем по
+# порядку; пропавший кусок ждём STREAM_HOLE и перешагиваем.
+#   POST /speak/chunk?sid=<сеанс>&seq=<номер>[&last=1]  тело = PCM S16LE 16кГц моно
+STREAM_RATE = 16000
+STREAM_HOLE = float(os.environ.get("CTL_STREAM_HOLE", "0.5"))
+STREAM_IDLE = float(os.environ.get("CTL_STREAM_IDLE", "3.0"))
+STREAM_PREBUF = float(os.environ.get("CTL_STREAM_PREBUF", "0.25"))
+
+_stream = None
+_stream_lock = threading.Lock()
+
+
+class _SpeakStream(object):
+    def __init__(self, sid):
+        self.sid = sid
+        self.parts = {}
+        self.last_seq = None
+        self.next = 0
+        self.cv = threading.Condition()
+        self.t_last = time.time()
+        self.t0 = time.time()
+        self.played = 0
+        self.gain = None
+        self.holes = 0
+        self.dead = False
+        self.proc = None
+        self.dev = None
+        self.err = None
+        threading.Thread(target=self._run, daemon=True).start()
+
+    def put(self, seq, data, last):
+        with self.cv:
+            if seq >= self.next and seq not in self.parts:
+                self.parts[seq] = data
+            if last:
+                self.last_seq = seq
+            self.t_last = time.time()
+            self.cv.notify()
+
+    def _open(self, dev):
+        return subprocess.Popen(
+            ["aplay", "-q", "-D", dev, "-t", "raw", "-f", "S16_LE",
+             "-r", str(STREAM_RATE), "-c", "1", "-B", "200000"],
+            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+    def _level(self, pcm):
+        import audioop
+        full = 32767.0
+        step = int(STREAM_RATE * 0.02) * 2
+        rmss, pks = [], []
+        for i in range(0, len(pcm) - step + 1, step):
+            fr = pcm[i:i + step]
+            rmss.append(audioop.rms(fr, 2))
+            pks.append(audioop.max(fr, 2))
+        if rmss:
+            rmss.sort()
+            pks.sort()
+            r = rmss[min(int(len(rmss) * 0.90), len(rmss) - 1)]
+            pk = pks[min(int(len(pks) * 0.95), len(pks) - 1)]
+            if r > 300 and pk > 0:
+                want = SPEAK_TARGET * full / r
+                want = min(want, SPEAK_PEAK * full / pk, SPEAK_MAX_GAIN)
+                want = max(want, 0.2) * SPEAK_BOOST
+                self.gain = want if self.gain is None else (0.7 * self.gain + 0.3 * want)
+        g = (self.gain if self.gain is not None else 1.0) * _vol["radio"]
+        if abs(g - 1.0) > 0.02:
+            pcm = audioop.mul(pcm, 2, g)
+        return pcm
+
+    def _write(self, pcm):
+        if not pcm:
+            return
+        pcm = self._level(pcm)
+        ahead = self.played / 2.0 / STREAM_RATE - (time.time() - self.t_play)
+        voice_mute(max(0.0, ahead) + len(pcm) / 2.0 / STREAM_RATE + MUTE_TAIL, "speak")
+        try:
+            self.proc.stdin.write(pcm)
+            self.proc.stdin.flush()
+        except Exception:
+            err = "aplay вышел с кодом %s" % self.proc.poll()
+            alt = spk_alsa_direct()
+            if alt and alt != self.dev:
+                log("рация потоком: %s не принял (%s), играю в %s" % (self.dev, err[:60], alt))
+                jlog("speak_fallback", device=alt, why=err[:80], stream=True)
+                self.dev = alt
+                self.proc = self._open(alt)
+                self.proc.stdin.write(pcm)
+                self.proc.stdin.flush()
+            else:
+                raise
+        self.played += len(pcm)
+
+    def _run(self):
+        ok = True
+        try:
+            nope = no_speaker()
+            if nope:
+                self.err = nope
+                return
+            ensure_loud()
+            voice_mute(STREAM_IDLE + MUTE_TAIL, "speak")
+            with self.cv:
+                end = time.time() + 1.0
+                while (sum(len(v) for v in self.parts.values()) < STREAM_PREBUF * STREAM_RATE * 2
+                       and self.last_seq is None and time.time() < end):
+                    self.cv.wait(0.05)
+            self.dev = spk_device()
+            self.proc = self._open(self.dev)
+            self.t_play = time.time()
+            hole_t = None
+            while True:
+                with self.cv:
+                    while True:
+                        if self.next in self.parts:
+                            data = self.parts.pop(self.next)
+                            self.next += 1
+                            hole_t = None
+                            break
+                        if self.last_seq is not None and self.next > self.last_seq:
+                            data = None
+                            break
+                        now = time.time()
+                        if now - self.t_last > STREAM_IDLE or self.dead:
+                            data = None
+                            break
+                        if self.parts and min(self.parts) > self.next:
+                            hole_t = hole_t or now
+                            if now - hole_t > STREAM_HOLE:
+                                self.holes += 1
+                                self.next = min(self.parts)
+                                continue
+                        self.cv.wait(0.05)
+                if data is None:
+                    break
+                self._write(data)
+                if self.played > MAX_SPEAK * STREAM_RATE * 2:
+                    self.err = "слишком длинно, обрезано на %.0f с" % MAX_SPEAK
+                    break
+        except Exception as e:
+            ok, self.err = False, str(e)[:150]
+        finally:
+            if self.proc is not None:
+                try:
+                    self.proc.stdin.close()
+                except Exception:
+                    pass
+                try:
+                    self.proc.wait(timeout=MAX_SPEAK + 5)
+                except Exception:
+                    self.proc.kill()
+            voice_mute(0, "speak_stream")
+            voice_mute(MUTE_TAIL, "speak_stream")
+            sec = self.played / 2.0 / STREAM_RATE
+            jlog("speak", stream=True, sec=round(sec, 2), took=round(time.time() - self.t0, 2),
+                 ok=ok and not self.err, err=self.err, device=self.dev, holes=self.holes,
+                 gain=round(self.gain or 1.0, 2), chunks=self.next)
+            global _stream
+            with _stream_lock:
+                if _stream is self:
+                    _stream = None
+
+
+def handle_speak_chunk(sid, seq, last, data):
+    global _stream
+    if not sid:
+        return {"ok": False, "error": "нет sid"}
+    with _stream_lock:
+        st = _stream
+        if st is None or st.sid != sid:
+            if st is not None:
+                st.dead = True
+                with st.cv:
+                    st.cv.notify()
+            st = _stream = _SpeakStream(sid)
+    if st.err:
+        return {"ok": False, "error": st.err}
+    st.put(seq, data, last)
+    return {"ok": True, "seq": seq}
+
