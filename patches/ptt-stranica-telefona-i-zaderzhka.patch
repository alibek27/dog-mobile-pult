 class H(BaseHTTPRequestHandler):
+    # TCP_NODELAY. Без него сервер шлёт заголовки и тело разными кусками, и
+    # второй кусок ждёт подтверждения первого: замер 20.09 с ноутбука через
+    # 4G — 145-186 мс на запрос при пинге 50 мс, с этой строкой 51-106 мс.
+    # Для пульта это полшага собаки на каждую команду.
+    disable_nagle_algorithm = True
+
+    # Рукопожатие TLS — ЗДЕСЬ, в потоке соединения, и со сроком.
+    # До 19.09 оно шло внутри accept() основного потока (wrap_socket на
+    # слушающем сокете). Телефон по 4G открыл соединение и пропал на полпути —
+    # и весь вход встал: accept ждал его вечно, очередь (5 мест) забилась, ни
+    # телефон, ни ноутбук не могли открыть ни кабинет, ни пульт, ни видео.
+    timeout = 60                      # молчащее соединение не держим вечно
+
+    def setup(self):
+        self.request.settimeout(15)
+        self.request.do_handshake()
+        BaseHTTPRequestHandler.setup(self)
+
     server_version = "aktemir"
